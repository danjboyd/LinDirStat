{
  "$schema": "./../gnustep/gnustep-packager/schemas/gnustep-packager.schema.json",
  "schemaVersion": 1,
  "profiles": [
    "gnustep-gui"
  ],
  "package": {
    "id": "org.lindirstat.LinDirStat",
    "name": "LinDirStat",
    "displayName": "LinDirStat",
    "version": "0.1.2",
    "manufacturer": "Daniel Boyd",
    "summary": "GNUstep disk usage viewer inspired by WinDirStat.",
    "license": "GPL-2.0-or-later",
    "homepage": "https://github.com/danjboyd/LinDirStat"
  },
  "pipeline": {
    "workingDirectory": ".",
    "shell": {
      "kind": "bash",
      "bootstrapCommands": [],
      "environment": {}
    },
    "build": {
      "command": "./scripts/package-build.sh"
    },
    "stage": {
      "command": "./scripts/package-stage.sh dist/stage",
      "outputRoot": "dist/stage"
    }
  },
  "payload": {
    "layoutVersion": 1,
    "stageRoot": "dist/stage",
    "appRoot": "app",
    "runtimeRoot": "runtime",
    "metadataRoot": "metadata",
    "runtimeSeedPaths": [
      "runtime/bin/defaults"
    ]
  },
  "launch": {
    "entryRelativePath": "app/LinDirStat.app/LinDirStat",
    "workingDirectory": "app/LinDirStat.app",
    "arguments": [],
    "env": {
      "GNUSTEP_CONFIG_FILE": "{@runtimeRoot}/etc/GNUstep/GNUstep.conf",
      "LD_LIBRARY_PATH": "{@runtimeRoot}/lib",
      "GSTheme": {
        "value": "Adwaita",
        "policy": "ifUnset"
      }
    }
  },
  "outputs": {
    "root": "dist",
    "packageRoot": "dist/packages",
    "logRoot": "dist/logs",
    "tempRoot": "dist/tmp",
    "validationRoot": "dist/validation"
  },
  "validation": {
    "smoke": {
      "enabled": true,
      "kind": "staged-layout",
      "requiredPaths": [
        "app/LinDirStat.app/LinDirStat",
        "app/LinDirStat.app/Resources/Info-gnustep.plist",
        "metadata/icons/lindirstat.png",
        "metadata/licenses/LinDirStat.txt",
        "metadata/licenses/host-libraries.txt",
        "runtime/bin/defaults",
        "runtime/bin/make_services",
        "runtime/etc/GNUstep/GNUstep.conf",
        "runtime/etc/GNUstep/GlobalDefaults.plist",
        "runtime/lib/libOpenSave.so.0",
        "runtime/lib/libgnustep-gui.so.0.32",
        "runtime/System/Library/Bundles/libgnustep-back-032.bundle/libgnustep-back-032",
        "runtime/System/Library/Themes/Adwaita.theme/Adwaita"
      ],
      "timeoutSeconds": 30
    },
    "logs": {
      "retainOnSuccess": true
    },
    "packageContract": {
      "requiredContent": [
        {
          "kind": "notice-report"
        },
        {
          "kind": "bundled-theme",
          "name": "Adwaita"
        },
        {
          "kind": "metadata-file",
          "path": "metadata/icons/lindirstat.png"
        }
      ]
    },
    "installedResult": {
      "requiredContent": [
        {
          "kind": "notice-report"
        },
        {
          "kind": "bundled-theme",
          "name": "Adwaita"
        }
      ],
      "requiredPaths": [
        "usr/metadata/icons/lindirstat.png",
        "usr/runtime/etc/GNUstep/GlobalDefaults.plist"
      ]
    }
  },
  "updates": {
    "enabled": true,
    "provider": "github-release-feed",
    "channel": "stable",
    "minimumCheckIntervalHours": 24,
    "startupDelaySeconds": 15,
    "publicEDKey": "SKdoAEydF4ABzOBG2lV37MtSXLjkB3fefGAkDEJUo3U=",
    "github": {
      "owner": "danjboyd",
      "repo": "LinDirStat-releases",
      "tagPattern": "v{version}",
      "releaseNotesUrlPattern": "https://github.com/{owner}/{repo}/releases/tag/{tag}"
    }
  },
  "integrations": {
    "shortcutName": "LinDirStat",
    "categories": [
      "System",
      "FileTools"
    ],
    "fileAssociations": []
  },
  "compliance": {
    "runtimeNotices": [
      {
        "name": "LinDirStat",
        "version": "0.1.2",
        "license": "GPL-2.0-or-later",
        "source": "LinDirStat application source",
        "homepage": "https://github.com/danjboyd/LinDirStat",
        "stageRelativePath": "metadata/licenses/LinDirStat.txt"
      },
      {
        "name": "WinDirStat Reference Source",
        "license": "GPL-2.0-or-later",
        "source": "Translations generated from WinDirStat's language files; source kept as reference only",
        "homepage": "https://github.com/windirstat/windirstat",
        "stageRelativePath": "metadata/licenses/WinDirStat-reference.txt"
      },
      {
        "name": "GNUstep Base",
        "license": "LGPL-2.1-or-later",
        "source": "runtime/lib/libgnustep-base.so.1.31",
        "homepage": "https://github.com/gnustep/libs-base",
        "stageRelativePath": "metadata/licenses/GNUstep-base.txt"
      },
      {
        "name": "GNUstep GUI",
        "license": "LGPL-2.1-or-later",
        "source": "runtime/lib/libgnustep-gui.so.0.32",
        "homepage": "https://github.com/gnustep/libs-gui",
        "stageRelativePath": "metadata/licenses/GNUstep-gui.txt"
      },
      {
        "name": "GNUstep Back",
        "version": "bf3b3ce with the patches in packaging/linux/libs-back",
        "license": "LGPL-2.1-or-later",
        "source": "runtime/System/Library/Bundles/libgnustep-back-032.bundle",
        "homepage": "https://github.com/gnustep/libs-back",
        "stageRelativePath": "metadata/licenses/GNUstep-back.txt"
      },
      {
        "name": "libobjc2",
        "license": "MIT",
        "source": "runtime/lib/libobjc.so.4.6",
        "homepage": "https://github.com/gnustep/libobjc2",
        "stageRelativePath": "metadata/licenses/libobjc2.txt"
      },
      {
        "name": "libdispatch",
        "license": "Apache-2.0",
        "source": "runtime/lib/libdispatch.so",
        "homepage": "https://github.com/swiftlang/swift-corelibs-libdispatch",
        "stageRelativePath": "metadata/licenses/libdispatch.txt"
      },
      {
        "name": "libs-OpenSave",
        "license": "LGPL-2.1-or-later",
        "source": "runtime/lib/libOpenSave.so.0",
        "homepage": "https://github.com/danjboyd/libs-OpenSave",
        "stageRelativePath": "metadata/licenses/libs-OpenSave.txt"
      },
      {
        "name": "Adwaita GNUstep theme",
        "license": "LGPL-2.1-or-later",
        "source": "runtime/System/Library/Themes/Adwaita.theme",
        "homepage": "https://github.com/danjboyd/plugins-themes-Adwaita",
        "stageRelativePath": "metadata/licenses/Adwaita-theme.txt"
      },
      {
        "name": "gnustep-packager updater",
        "license": "MIT",
        "source": "Linked into the app (GPUpdaterCore, GPUpdaterUI) and app/LinDirStat.app/gp-update-helper",
        "homepage": "https://github.com/danjboyd/gnustep-packager",
        "stageRelativePath": "metadata/licenses/gnustep-packager-updater.txt"
      },
      {
        "name": "Monocypher",
        "version": "4.0.2",
        "license": "BSD-2-Clause OR CC0-1.0",
        "source": "Compiled into gp-update-helper",
        "homepage": "https://monocypher.org",
        "stageRelativePath": "metadata/licenses/Monocypher.txt"
      },
      {
        "name": "Bundled distribution libraries",
        "license": "Various; see host-libraries/ copyright files",
        "source": "Debian packages listed in host-libraries.txt",
        "stageRelativePath": "metadata/licenses/host-libraries.txt"
      }
    ]
  },
  "platformOverrides": {
    "linux": {
      "backends": {
        "dmg": {
          "enabled": false
        }
      }
    },
    "macos": {
      "profiles": [],
      "pipeline": {
        "build": {
          "command": "make -C macos"
        },
        "stage": {
          "command": "./scripts/package-stage-macos.sh dist/stage",
          "outputRoot": "dist/stage"
        }
      },
      "payload": {
        "runtimeSeedPaths": []
      },
      "launch": {
        "entryRelativePath": "app/LinDirStat.app/Contents/MacOS/LinDirStat",
        "workingDirectory": "app",
        "env": null
      },
      "validation": {
        "smoke": {
          "requiredPaths": [
            "app/LinDirStat.app/Contents/Info.plist",
            "app/LinDirStat.app/Contents/Resources/LinDirStat.icns",
            "metadata/licenses/LinDirStat.txt",
            "metadata/licenses/WinDirStat-reference.txt"
          ]
        },
        "packageContract": null,
        "installedResult": {
          "requiredContent": [
            {
              "kind": "notice-report"
            }
          ],
          "requiredPaths": [
            "LinDirStat.app/Contents/MacOS/LinDirStat",
            "LinDirStat.app/Contents/Resources/LinDirStat.icns"
          ]
        }
      },
      "compliance": {
        "runtimeNotices": [
          {
            "name": "LinDirStat",
            "version": "0.1.2",
            "license": "GPL-2.0-or-later",
            "source": "LinDirStat application source",
            "homepage": "https://github.com/danjboyd/LinDirStat",
            "stageRelativePath": "metadata/licenses/LinDirStat.txt"
          },
          {
            "name": "WinDirStat Reference Source",
            "license": "GPL-2.0-or-later",
            "source": "Local reference source only; not linked into LinDirStat",
            "homepage": "https://github.com/windirstat/windirstat",
            "stageRelativePath": "metadata/licenses/WinDirStat-reference.txt"
          }
        ]
      },
      "updates": {
        "enabled": false
      }
    }
  },
  "backends": {
    "msi": {
      "enabled": false
    },
    "appimage": {
      "enabled": true,
      "desktopEntryName": "lindirstat.desktop",
      "iconRelativePath": "metadata/icons/lindirstat.png",
      "validation": {
        "runtimeClosure": "strict"
      },
      "smoke": {
        "mode": "launch-only"
      },
      "updates": {
        "feedUrl": "https://danjboyd.github.io/LinDirStat-releases/updates/linux/stable.json",
        "embedUpdateInformation": true,
        "releaseSelector": "latest"
      }
    },
    "dmg": {
      "enabled": true,
      "finderLayout": "auto",
      "noticeReport": {
        "enabled": true
      },
      "signing": {
        "identity": "-",
        "resign": false,
        "entitlementsPath": "macos/LinDirStat.entitlements"
      },
      "notarization": {
        "enabled": false,
        "keychainProfileEnvVar": "LINDIRSTAT_NOTARY_PROFILE"
      },
      "smoke": {
        "startupSeconds": 8,
        "environment": {
          "LINDIRSTAT_SCAN_PATH": "/usr/share/zoneinfo"
        }
      }
    }
  }
}

+			     location: NSZeroPoint
+			modifierFlags: 0
+			    timestamp: 0
+			 windowNumber: win->number
+			      context: gcontext
+			      subtype: GSAppKitWindowMoved
+				data1: n.origin.x
+				data2: n.origin.y];
+      [window sendEvent: e];
+      win->monitor_id = [[window screen] screenNumber];
+    }
+}

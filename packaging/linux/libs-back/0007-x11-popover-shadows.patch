From fd6e241 Mon Sep 17 00:00:00 2001
From: Daniel Boyd <danieljboyd@icloud.com>
Subject: [PATCH] x11, cairo: popover shadows for menus, when a theme asks

Backport to back-0_32_0 of the source change in ai-policy/csd-series (fd6e241), from plugins-themes-Adwaita 0.1.0-alpha18's Docs/upstream-patches/, without its ChangeLog entry and tests.

---
diff --git a/Headers/x11/XGServerWindow.h b/Headers/x11/XGServerWindow.h
index 81bbd7b..a8257dd 100644
--- a/Headers/x11/XGServerWindow.h
+++ b/Headers/x11/XGServerWindow.h
@@ -113,6 +113,8 @@ typedef struct _gswindow_device_t {
 					  fullscreen nor tiled */
   BOOL                  shadow_resizable; /* Takes presses in a band round
 					  the visible part, for resizing */
+  BOOL                  shadow_popover; /* A popover's (a menu's) smaller
+					  margin and shadow, not a window's */
   BOOL                  shadow_settling; /* That margin changed and the
 					  window manager is fitting the
 					  window to it: the gui hears of
diff --git a/Source/cairo/XGCairoModernSurface.m b/Source/cairo/XGCairoModernSurface.m
index e334283..71b82dc 100644
--- a/Source/cairo/XGCairoModernSurface.m
+++ b/Source/cairo/XGCairoModernSurface.m
@@ -88,6 +88,50 @@ shadow_alpha(double px, double py, double x0, double x1, double y0, double y1,
   return side;
 }
 
+/*
+ * One layer of a CSS box-shadow round a rounded box: the box grown by
+ * `spread` (its corner radius too) and moved down by `offset`, blurred by
+ * `blur` (a Gaussian with half that as its deviation), as seen at (px, py).
+ * Computed from the distance to the grown box's rounded outline, so it
+ * follows the corners as a browser's does.
+ */
+static double
+box_shadow_layer(double px, double py, double x0, double x1, double y0,
+		 double y1, double radius, double offset, double spread,
+		 double blur)
+{
+  double r = radius + spread;
+  double left = x0 - spread, right = x1 + spread;
+  double top = y0 - spread + offset, bottom = y1 + spread + offset;
+  double qx = MAX(MAX(left + r - px, px - (right - r)), 0.0);
+  double qy = MAX(MAX(top + r - py, py - (bottom - r)), 0.0);
+  double d = sqrt(qx * qx + qy * qy) - r;
+
+  return 0.5 * erfc(d / (blur / 2.0 * M_SQRT2));
+}
+
+/*
+ * A popover's shadow (libadwaita's popover contents): box-shadow
+ * 0 1px 5px 1px black at 0.09, and 0 2px 14px 3px black at 0.05, at
+ * scale 1, round its rounded corners. 0 inside the rounded visible part.
+ */
+static double
+popover_shadow_alpha(double px, double py, double x0, double x1, double y0,
+		     double y1, double radius, double scale)
+{
+  double dx = MAX(MAX(x0 + radius - px, px - (x1 - radius)), 0.0);
+  double dy = MAX(MAX(y0 + radius - py, py - (y1 - radius)), 0.0);
+
+  if (sqrt(dx * dx + dy * dy) <= radius && px > x0 && px < x1 && py > y0 && py < y1)
+    {
+      return 0.0;
+    }
+  return 0.09 * box_shadow_layer(px, py, x0, x1, y0, y1, radius,
+				 1 * scale, 1 * scale, 5 * scale)
+    + 0.05 * box_shadow_layer(px, py, x0, x1, y0, y1, radius,
+			      2 * scale, 3 * scale, 14 * scale);
+}
+
 static inline uint32_t
 shadow_pixel(double alpha)
 {
@@ -114,10 +158,11 @@ typedef struct {
 
 static cairo_surface_t *
 shadow_template(cairo_surface_t *similar, const int *margin, int radius,
-		double scale)
+		double scale, BOOL popover)
 {
-  static shadow_cache windowCache;
-  shadow_cache *cache = &windowCache;
+  /* One for windows, one for popovers. */
+  static shadow_cache caches[2];
+  shadow_cache *cache = &caches[popover ? 1 : 0];
   int width = margin[0] + 2 * radius + SHADOW_TILE + margin[1];
   int height = margin[2] + 2 * radius + SHADOW_TILE + margin[3];
   double x0 = margin[0], x1 = width - margin[1];
@@ -149,8 +194,9 @@ shadow_template(cairo_surface_t *similar, const int *margin, int radius,
 
       for (x = 0; x < width; x++)
 	{
-	  row[x] = shadow_pixel(shadow_alpha(x + 0.5, y + 0.5, x0, x1, y0, y1,
-					     radius, scale));
+	  row[x] = shadow_pixel(popover
+	    ? popover_shadow_alpha(x + 0.5, y + 0.5, x0, x1, y0, y1, radius, scale)
+	    : shadow_alpha(x + 0.5, y + 0.5, x0, x1, y0, y1, radius, scale));
 	}
     }
   cairo_surface_mark_dirty(image);
@@ -200,7 +246,7 @@ shadow_copy(cairo_t *cr, cairo_surface_t *template, double sx, double sy,
  */
 static cairo_surface_t *
 create_shadow(cairo_surface_t *similar, int width, int height,
-	      const int *margin, int radius, double scale)
+	      const int *margin, int radius, double scale, BOOL popover)
 {
   int l = margin[0], r = margin[1], t = margin[2], b = margin[3];
   cairo_surface_t *template, *shadow;
@@ -212,7 +258,7 @@ create_shadow(cairo_surface_t *similar, int width, int height,
     {
       return NULL;
     }
-  template = shadow_template(similar, margin, radius, scale);
+  template = shadow_template(similar, margin, radius, scale, popover);
   if (template == NULL)
     {
       return NULL;
@@ -312,7 +358,8 @@ create_shadow(cairo_surface_t *similar, int width, int height,
 					 GSWINDEVICE->xframe.size.height,
 					 GSWINDEVICE->shadow,
 					 GSWINDEVICE->corner_radius,
-					 GSWINDEVICE->shadow_scale);
+					 GSWINDEVICE->shadow_scale,
+					 GSWINDEVICE->shadow_popover);
 	}
 
       /*NSLog(@"Window surface type %d, back buffer type %d, w %d h %d",
diff --git a/Source/x11/XGServerWindow.m b/Source/x11/XGServerWindow.m
index 15e8db9..0c2603d 100644
--- a/Source/x11/XGServerWindow.m
+++ b/Source/x11/XGServerWindow.m
@@ -629,6 +629,17 @@ BOOL AtomPresentAndPointsToItself(Display *dpy, Atom atom, Atom type)
  */
 static const int shadowMargin[4] = { 30, 30, 24, 36 };
 
+/* A popover's (libadwaita's menus): its shadow is smaller and fades out
+ * within about 14 pixels at the sides, less above and more below.
+ */
+static const int popoverMargin[4] = { 14, 14, 12, 16 };
+
+static inline const int *
+marginFor(gswindow_device_t *win)
+{
+  return win->shadow_popover ? popoverMargin : shadowMargin;
+}
+
 /* How far outside the visible edge a resizable window takes presses, for
  * resizing from the shadow (GTK 4 under Mutter: 12 pixels).
  */
@@ -803,6 +814,34 @@ static int compositorRunning = -1;
   return [self _compositorShowsAlpha];
 }
 
+/*
+ * A borderless window marked as a popover (NSUtilityWindowMask, which a
+ * borderless window has no other use for; the Adwaita theme marks its
+ * menus) gets a popover's margin and shadow when GSBackPopoverShadows is
+ * YES, on the same terms as a window's: the window manager must know the
+ * margin isn't part of the window, and the compositing manager must show
+ * transparency. GSBackPopoverCornerRadius rounds its corners.
+ */
+- (BOOL) _windowGetsPopoverShadow: (unsigned int)style
+{
+  if (handlesWindowDecorations
+    || (style & (NSTitledWindowMask | NSClosableWindowMask
+		 | NSMiniaturizableWindowMask | NSResizableWindowMask
+		 | NSDocModalWindowMask | NSIconWindowMask | NSMiniWindowMask
+		 | NSFullScreenWindowMask)) != 0
+    || (style & NSUtilityWindowMask) == 0
+    || [[NSUserDefaults standardUserDefaults]
+	 boolForKey: @"GSBackPopoverShadows"] == NO)
+    {
+      return NO;
+    }
+  if (![self _checkWMSupports: generic._GTK_FRAME_EXTENTS_ATOM])
+    {
+      return NO;
+    }
+  return [self _compositorShowsAlpha];
+}
+
 /*
  * A borderless window (menus, tool tips) gets an alpha channel when
  * GSBackBorderlessWindowAlpha is YES (a theme that draws them with rounded
@@ -882,7 +921,7 @@ static int compositorRunning = -1;
     }
   for (i = 0; i < 4; i++)
     {
-      int wanted = flat ? 0 : shadowScaled(shadowMargin[i], win->shadow_scale);
+      int wanted = flat ? 0 : shadowScaled(marginFor(win)[i], win->shadow_scale);
 
       if (win->shadow[i] != wanted)
 	{
@@ -2362,21 +2401,24 @@ _extentsUsable(unsigned long *extents, unsigned style)
         = style & (NSIconWindowMask | NSMiniWindowMask);
     }
   /* A non-retained window has no backing store to keep its shadow in. */
-  if (type != NSBackingStoreNonretained && [self _windowGetsShadow: style])
+  if (type != NSBackingStoreNonretained
+    && ([self _windowGetsShadow: style] || [self _windowGetsPopoverShadow: style]))
     {
       int i;
 
       window->shadow_eligible = YES;
+      window->shadow_popover = [self _windowGetsPopoverShadow: style];
       window->shadow_resizable = (style & NSResizableWindowMask) != 0;
       window->shadow_scale = shadowScale();
       for (i = 0; i < 4; i++)
 	{
-	  window->shadow[i] = shadowScaled(shadowMargin[i],
+	  window->shadow[i] = shadowScaled(marginFor(window)[i],
 					   window->shadow_scale);
 	}
       window->corner_radius = shadowScaled(MAX(0,
 	[[NSUserDefaults standardUserDefaults]
-	  integerForKey: @"GSBackWindowCornerRadius"]), window->shadow_scale);
+	  integerForKey: window->shadow_popover ? @"GSBackPopoverCornerRadius"
+	    : @"GSBackWindowCornerRadius"]), window->shadow_scale);
     }
 
   frame = [self _OSFrameToXFrame: frame for: window];
